# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=put_your_bot_token_here

# ID of the main Discord server where clans and clan roles live.
MAIN_GUILD_ID=1539760704641437837

# Optional: use the old variable name from the uploaded cog instead.
# VESTIGE_GUILD_ID=123456789012345678

SERVER_NAME=Main Server
DATABASE_PATH=data/roster.db
THEME_COLOR=12583167
MAX_MEMBERS=200
INVITE_EXPIRY_DAYS=7

# Optional. Set this to a test server ID for fast slash-command updates.
# Without it, commands are synced globally and may take a while to appear.
COMMAND_SYNC_GUILD_ID=

# Separate Railway services cannot share a local SQLite file. Set these three
# values to enable the authenticated RCE HTTP bridge instead.
# RCE_SYNC_URL should be the public URL of the RCE service, without a trailing slash.
RCE_SYNC_URL=
RCE_SYNC_TOKEN=use_the_same_long_random_value_on_both_services
RCE_SYNC_TIMEOUT=15

# Optional: identify the RCE game server used for automatically created clans.
# If omitted, the RCE bridge uses its SERVER_SLUG or its only game server.
RCE_SERVER_ID=
RCE_SERVER_NAME=

LOG_LEVEL=INFO